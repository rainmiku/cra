<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Renderer (V8) and GPU (SwiftShader) helpers only, as in Chromium's
	     helper-renderer-entitlements.plist and helper-gpu-entitlements.plist. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
